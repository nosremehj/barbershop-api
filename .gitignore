# ==============================================================================
# Java & Spring Boot .gitignore - Padrão Corporativo / Produção
# ==============================================================================

# Compilação e Builds
target/
build/
*.class
*.jar
*.war
*.ear
*.nar

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configurações de IDEs e Editores
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace

# Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Segurança e Variáveis de Ambiente (CRÍTICO: Nunca commitar segredos)
.env
*.env.*
!.env.example
application-secret.yml
application-secret.properties
secrets/
*.pem
*.key
*.jks

# Docker e Containers Locais
docker-compose.override.yml
.docker/

# Cobertura e Relatórios de Testes
.nyc_output/
coverage/
.gradle/
.m2/
