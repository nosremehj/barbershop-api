# ==============================================================================
# Variáveis de Ambiente de Exemplo (Copie para .env e ajuste para seu ambiente)
# ==============================================================================

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barbershop_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Spring Security & JWT
JWT_SECRET=super_secret_jwt_key_with_at_least_256_bits_length_for_hmac_sha256
JWT_EXPIRATION_HOURS=24

# Integração WhatsApp API
WHATSAPP_API_URL=http://localhost:8080/message/sendText
WHATSAPP_API_KEY=sua_chave_api_aqui

# Integração Pagamentos (Mercado Pago / Pix)
MERCADO_PAGO_ACCESS_TOKEN=seu_token_aqui
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui
